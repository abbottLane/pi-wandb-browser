{
	"name": "pi-wandb-browser",
	"version": "0.1.0",
	"description": "Browse Weights & Biases projects, runs, metric charts, and run files inside the pi coding agent",
	"type": "module",
	"license": "MIT",
	"author": "William Lane",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/abbottLane/pi-wandb-browser.git"
	},
	"homepage": "https://github.com/abbottLane/pi-wandb-browser#readme",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"wandb",
		"weights-and-biases",
		"tui",
		"charts"
	],
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"check": "biome check --write . && tsc --noEmit",
		"test": "vitest --run"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@earendil-works/pi-coding-agent": "1.5.2",
		"@earendil-works/pi-tui": "1.5.2",
		"@types/node": "22.19.19",
		"typescript": "7.0.2",
		"vitest": "4.1.12"
	}
}
